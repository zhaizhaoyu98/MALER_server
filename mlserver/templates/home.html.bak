<!DOCTYPE html>
<html><!--search.html-->
<head>
    <title>Home</title>
	<meta charset="utf-8">
	{% include 'public_templates/bootstrap.html' %}

	<style>
		#demo{
			max-width: 100%;
			max-height: 100%;
		}
		.carousel-caption{
			color: #000000;
		}
		#version_table tbody tr td{
			font-size: 17px;
			text-align: center;
		}
		#version_table thead th{
			font-size: 17px;
		}
		.card-body .row{
			line-height: 40px;
		}
		.card-body .row img{
			padding: 0 10px 0 10px;
		}
		#data_statistic_table tbody th{
			font-weight: normal;

		}


		#slideshow .card{
			border: 1px dashed #ababab;
			padding-top: 20px;
		}
		/* 最下面 数据统计部分*/
		#total_data_static .row{
			line-height: 1.0;
		}
		#data_statistic_table tbody tr td{
			/* line-height: 5px; */
			padding: 2px 0 2px 10px;
			/* height: 15px; */

		}
		#total_data_static .row img{
			padding-bottom: 15px;
		}
		/* 轮播图字体 */
		#slideshow .card-title{
			font-size: 17px;
		}
		/* static-table的border */
		.table-bordered td, .table-bordered th{
			border: 1px solid #c7c7c7;
		}
		/* 右箭头标记 */
		.mark-symbol{
			color: #6495ED;font-size: 25px;padding-left: 1rem;font-weight: lighter;
		}

		#statistic tbody tr td:first-child{
			text-align: left;
			padding-top: 0;
			padding-bottom: 0;
			margin-bottom: 0;
		}
		#statistic {
			margin-bottom: 0;
		}
		#statistic_td {
			padding: 10px;
		}
		#statistic tbody tr td:nth-child(2){
			text-align: right;
			padding-top: 0;
			padding-bottom: 0;
		}
		#statistic tbody tr:nth-child(1){
			border-bottom: 1px solid #ababab;
		}
	</style>
	<script>
		$(document).ready(function() {
			$("#nav_home").addClass("active");
			$("#page_title").text('HOME');
			console.log($("input[name='csrfmiddlewaretoken']").attr('value'))
		});
	</script>
</head>
<body>
		<!-- 导航栏 -->
		{% include 'public_templates/nav_tem.html' %}
		<div class="container">
			<div class="row">
				<div class="col-lg-3 col-sm-2 mb-4"></div>
				<div class="col-lg-6 col-sm-8 mb-4" style="margin-bottom: 0px;">
					<div class="row" >
						<img style="width: 23%;height: 23%;margin-top: 2rem;margin-left: 50px;" src="/pertorg_static/img/pertorg_logo3.png"/>
						<div class="col" style="padding-left: 0px;">
							<h1 class="text-center" style="margin-top: 2rem;color: #17a2b8;font-size: 90px;margin-bottom: 0rem;">PertOrg</h1>
							<p style="color: darkgray;margin-left: 35px;">Version: 1.0</p>
						</div>

					</div>

					<!-- <h6 class="text-center blockquote-footer" style="color: #17a2b8;;font-size: 20px;">

					</h6> -->
					<!-- <p style="margin: 0 60px 0rem 0;color: darkgray;text-align: right;">Version: 1.0</p> -->
				</div>
				<div class="col-lg-3 col-sm-2 mb-4"></div>
			</div>

			<div class="row">
				<div class="col-lg-2 col-sm-0 mb-1"></div>
				<div class="col-lg-8 col-sm-12 mb-10">
					<!--搜索表单-->
					<div style="text-align: center">
						<form id='home_search' style="display: inline-block; margin: auto" class="form-inline" action="/pertorg/result"
						 method="get">
						 {% csrf_token %}
							<!-- <p name='csrfmiddlewaretoken' style="display: none;">{% csrf_token %}</p> -->
							<!-- 					<input id="query_content" class="form-control" style="width: 400px" type="search" placeholder="eg. DDPB00014 or Goserelin"
						 name='query_content' aria-label="Search"> -->
							<input id="query_content" class="form-control" style="min-width: 570px;margin-top: 0px;" type="search" placeholder=""
							 name='query_content' aria-label="Search">
							<button class="btn btn-info" style="margin-left: 5px;margin-top: 0px;" type="submit">Quick Search</button>
							<p>Enter a keyword of gene perturbation, e.g. gene name(<a href="#" onclick="test(this)">Slc39a8</a>),
							perturbation type(<a href="#" onclick="test(this)">knockout</a>),
							tissue(<a href="#" onclick="test(this)">kidney</a>),
							phenotype(<a href="#" onclick="test(this)">anemia</a>) or data type(<a href="#" onclick="test(this)">scRNA-Seq</a>).</p>
						</form>
						<br />
						<br />


						<!-- <img src="/pertorg_static/study_detail/Pertg00023/pics/GSEA/cel00010.png" /> -->
					</div>
				</div>
				<div class="col-lg-2 col-sm-0 mb-1"></div>
			</div>
		</div>


		<div class="container col-8">

			<!-- 文字加轮播图 -->
			<div class="card col-12" style="border: none;">
				<div class="row no-gutters">
					<div class="col-md-12">
						<div class="card-body" style="">
							<!-- 网站介绍 -->
							<h4 style="margin: 0 0 10px 0;">Welcome to PertOrg 1.0</h4>
							<p style="font-size: 23px;margin-bottom: 0;">
								A comprehensive resource of multilevel alterations induced in model organisms by <em style="font-size: 23px;">in vivo</em> genetic perturbation.
							</p>
						</div>
					</div>
				</div>
				<!-- 第二排 -->
				<div class="row no-gutters">
					<div class="col-lg-7 col-sm-12 mb-12">
						<div class="card-body">
							<!-- what -->
							<nav class="navbar navbar-dark text-white bg-info" style="border-radius: 10px 10px 0px 0px;font-weight: bolder;">
								What is PertOrg?
							</nav>
							<div class="card mb-3" style="border-radius: unset;border: 1px solid #ababab;">
								<div class="card-body" style="padding-bottom: ;">
									<!-- <h5 class="card-title">Secondary card title</h5> -->
									<p class="card-text">
										A genetically modified organism (GMO) is any organism whose genotype has been altered using
										genetic engineering techniques, e.g. knockdown, knockout and overexpression, et al, and could
										be considered a good model of human genetic disease or plant disease resistance. PertOrg
										1.0 is a free database that curates high-throughput gene expression data and associated information
										like phenotypic alterations from well-conducted studies involving <em>in vivo</em> genetic
										perturbation in eight model organisms. In current version, <b>58,707 transcriptome profiles</b> are collected,
										and <b>10,116 comparison datasets</b> including <b>122 scRNA-Seq datasets</b> are organized and analyzed.
										<b>8,644,148 differentially expressed genes</b> were identified and deposited as signatures of gene
										perturbations.
									</p>
								</div>
							</div>
						</div>
					</div>
					<!-- <div class="col-lg-1 col-sm-1 mb-1"></div> -->
					<div class="col-lg-5 col-sm-12 mb-12">
						<div class="card-body">
							<!-- what -->
							<nav class="navbar navbar-dark text-white bg-info" style="border-radius: 10px 10px 0px 0px;font-weight: bolder;">
								Statistic
							</nav>
							<div class="card mb-3" style="border-radius: unset;border: 1px solid #ababab;">

								<!-- <div class="card-body"> -->
									<!-- <h5 class="card-title">Secondary card title</h5> -->
								<table style="width: 100%;">
									<tbody>
										<tr>
											<td id="statistic_td">
												<table id="statistic" style="width: 100%;" class="table table-bordered">
													<thead></thead>
													<tbody>
														<tr style="border-bottom: #ababab nor;">
														    <td><h6>Organism</h6></td>
															<td><h6># Datasets</h6></td>
														</tr>
														<tr>
														    <td>Arabidopsis thaliana</td>
														    <td>797</td>
														</tr>
														<tr>
														    <td>Caenorhabditis elegans</td>
														    <td>161</td>
														</tr>
														<tr>
														    <td>Danio rerio</td>
														    <td>218</td>
														</tr>
														<tr>
														    <td>Drosophila melanogaster</td>
														    <td>520</td>
														</tr>
