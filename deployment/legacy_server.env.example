# Never commit real values. Load this file from the service manager or a
# protected root-owned environment file on the Aliyun host.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
DJANGO_ALLOWED_HOSTS=maler.example.org
# Django 2.1 expects bare host names here (scheme-prefixed origins are used by
# newer Django releases).
DJANGO_CSRF_TRUSTED_ORIGINS=maler.example.org
DJANGO_SECURE_SSL=True
DJANGO_HSTS_SECONDS=31536000
MALER_MODEL_SIGNING_KEY=REPLACE_WITH_AN_INDEPENDENT_64_CHARACTER_SECRET
MALER_CACHE_RETENTION_HOURS=24
MALER_MAX_DATA_UPLOAD_BYTES=209715200
MALER_MAX_MODEL_UPLOAD_BYTES=104857600
MALER_FILE_MEMORY_LIMIT_BYTES=5242880
MALER_WEB_OUTER_SPLITS=5
MALER_WEB_OUTER_REPEATS=2
MALER_WEB_INNER_SPLITS=3
MALER_WEB_N_JOBS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
